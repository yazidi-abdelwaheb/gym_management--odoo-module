<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_gym_member_list" model="ir.ui.view">
        <field name="name">gym.member.list</field>
        <field name="model">gym.member</field>
        <field name="arch" type="xml">
            <list string="Gym Members">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="registration_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="view_gym_member_form" model="ir.ui.view">
        <field name="name">gym.member.form</field>
        <field name="model">gym.member</field>
        <field name="arch" type="xml">
            <form string="Gym Member">
                <sheet>

                    <field name="image_1920"
                           widget="image"
                           class="oe_avatar"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Personal Information">
                            <field name="birthdate"/>
                            <field name="age" readonly="True"/>
                            <field name="gender"/>
                            <field name="phone"/>
                            <field name="email"
                                   required="1"
                                   help="A portal account is created automatically and an invitation is sent to this address."/>
                        </group>

                        <group string="Address">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Gym Information">
                        <field name="registration_date"/>
                        <field name="active"/>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- SEARCH VIEW -->
    <record id="view_gym_member_search" model="ir.ui.view">
        <field name="name">gym.member.search</field>
        <field name="model">gym.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>

                <filter
                    name="active_members"
                    string="Active Members"
                    domain="[('active', '=', True)]"/>

                <filter
                    name="inactive_members"
                    string="Inactive Members"
                    domain="[('active', '=', False)]"/>

                <group>
                    <filter
                        name="group_gender"
                        string="Gender"
                        context="{'group_by': 'gender'}"/>

                    <filter
                        name="group_city"
                        string="City"
                        context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_gym_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">gym.member</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gym_dashboard" model="ir.actions.client">
        <field name="name">Gym Dashboard</field>
        <field name="tag">gym_management.dashboard</field>
    </record>

    <menuitem
        id="gym_menu_root"
        name="Gym Management"
        sequence="10"
        groups="gym_management.group_gym_admin,gym_management.group_gym_receptionist,gym_management.group_gym_coach"
    />

    <menuitem
        id="gym_menu_dashboard"
        name="Dashboard"
        parent="gym_menu_root"
        action="action_gym_dashboard"
        sequence="5"
        groups="gym_management.group_gym_admin,gym_management.group_gym_receptionist,gym_management.group_gym_coach"
    />

    <menuitem
        id="gym_menu_members"
        name="Members"
        parent="gym_menu_root"
        action="action_gym_member"
        sequence="10"
        groups="gym_management.group_gym_admin,gym_management.group_gym_receptionist,gym_management.group_gym_coach"
    />

</odoo>
